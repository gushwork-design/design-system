{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin/ad-page-sheet",
      "destination": "/library/recipes/ad-landing-page",
      "permanent": false
    },
    {
      "source": "/preview/install",
      "destination": "/internal/claude-plugin",
      "permanent": false
    },
    {
      "source": "/preview/install.html",
      "destination": "/internal/claude-plugin",
      "permanent": false
    },
    {
      "source": "/preview/changelog-sheet",
      "destination": "/internal/changelog",
      "permanent": false
    },
    {
      "source": "/preview/changelog-sheet.html",
      "destination": "/internal/changelog",
      "permanent": false
    },
    {
      "source": "/internal/changelog-sheet",
      "destination": "/internal/changelog",
      "permanent": false
    },
    {
      "source": "/internal/changelog-sheet.html",
      "destination": "/internal/changelog",
      "permanent": false
    },
    {
      "source": "/internal/mini-tools",
      "destination": "/internal/tools",
      "permanent": false
    },
    {
      "source": "/preview/review-sheet",
      "destination": "/admin/design-system#review",
      "permanent": false
    },
    {
      "source": "/preview/review-sheet.html",
      "destination": "/admin/design-system#review",
      "permanent": false
    },
    {
      "source": "/preview/catalogue",
      "destination": "/admin/design-system#library",
      "permanent": false
    },
    {
      "source": "/preview/catalogue.html",
      "destination": "/admin/design-system#library",
      "permanent": false
    },
    {
      "source": "/preview/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin/usage-log",
      "destination": "/admin/analytics#usage",
      "permanent": false
    },
    {
      "source": "/admin/visits",
      "destination": "/admin/analytics#visits",
      "permanent": false
    },
    {
      "source": "/admin/insights",
      "destination": "/admin/analytics#insights",
      "permanent": false
    },
    {
      "source": "/admin/component-library",
      "destination": "/admin/design-system#library",
      "permanent": false
    },
    {
      "source": "/admin/catalogue",
      "destination": "/admin/design-system#library",
      "permanent": false
    },
    {
      "source": "/admin/review",
      "destination": "/admin/design-system#review",
      "permanent": false
    },
    {
      "source": "/admin/review-sheet",
      "destination": "/admin/design-system#review",
      "permanent": false
    },
    {
      "source": "/library",
      "destination": "/admin/design-system#library",
      "permanent": false
    },
    {
      "source": "/library/review",
      "destination": "/admin/design-system#review",
      "permanent": false
    },
    {
      "source": "/library/components",
      "destination": "/admin/design-system#library",
      "permanent": false
    },
    {
      "source": "/admin/workflow",
      "destination": "/admin/design-system#workflow",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/exports/dashboard/component-registry.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/auth/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/log-output",
      "destination": "/api/gw?action=log-output"
    },
    {
      "source": "/api/visits",
      "destination": "/api/gw?action=visits"
    },
    {
      "source": "/api/review",
      "destination": "/api/gw?action=review"
    },
    {
      "source": "/api/usage-log",
      "destination": "/api/gw?action=usage-log"
    },
    {
      "source": "/api/log-usage",
      "destination": "/api/gw?action=log-usage"
    },
    {
      "source": "/api/post-notice",
      "destination": "/api/gw?action=post-notice"
    },
    {
      "source": "/api/slack-events",
      "destination": "/api/gw?action=slack-events"
    },
    {
      "source": "/api/approvals",
      "destination": "/api/gw?action=approvals"
    },
    {
      "source": "/api/tools",
      "destination": "/api/gw?action=tools"
    }
  ],
  "functions": {
    "api/gw.js": {
      "includeFiles": "{assets/logo/**,assets/color/**,fonts/*.ttf,foundation/tokens.*,foundation/tailwind-theme.js,internal/templates.html}"
    }
  }
}
