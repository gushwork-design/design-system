<div class="rvp"><div class="vgroup"><div class="vhead"><code>Footers / Minimal</code></div><div class="grid" style="grid-template-columns:1fr"><div class="cell"><div class="stage g-dark" style="padding:0;align-items:stretch;border-radius:12px;min-height:0"><div class="ld" style="background:none;width:100%"><style>
.ld{font-family:var(--body,Inter,sans-serif);color:var(--gw-color-neutral-800);background:var(--gw-color-white);
  --gw-content-width:1240px;--gw-content-margin:100px;--gutter:var(--gw-content-margin);--nav-h:60px;--lattice:40px;
  font:var(--gw-text-body-16-reg);letter-spacing:var(--gw-text-body-16-reg-tracking);-webkit-font-smoothing:antialiased}
