#!/usr/bin/env bash
#
# Refuses to push `main` unless the push was deliberately authorised.
#
# Why this exists: nobody who *uses* the plugin can push — `claude plugin marketplace add`
# clones read-only, and the repo has one collaborator. The real risk is different: an agent
# session running in this clone pushes with your credentials, and GitHub cannot tell the two
# apart. This makes a push to main an explicit act rather than an incidental one.
#
# Install:  bash scripts/hooks/install.sh
# Authorise a single push:
#
#     GW_PUSH=1 git push origin main
#
# Be clear about what this is: a GUARD RAIL, not a security boundary. Anything that can run
# git in this clone can also set the variable. The only thing that genuinely stops an
# unreviewed push is server-side branch protection requiring a reviewed pull request — see
# the note in CONTRIBUTING.md.
#
# It also WARNS (never blocks) about two things that are invisible until someone else hits
# them on their own machine:
#
#   check-version.sh      plugin surface changed but the version field did not move, so no
#                         changelog row, no updated announce date, and nothing for the
#                         SessionStart update check to compare — the change ships silently.
#   check-placeholders.sh a page still carries {{...}} stubs.
#   check-skill-drift.sh  a skill names a token, path, node or component the repo does not
#                         hold. Skills are prose, and prose restates facts; check-drift.sh
#                         compares a BUILT PAGE against the registry and nothing compared
#                         the skills themselves. A wrong claim here is every future build
#                         being told something this repo contradicts.
#   review-pass.sh        something in skills/ has not been through a review pass, or a pass
#                         has expired because its source moved since. The 15 Sep ruling says
#                         measured -> drawn -> PASSED -> skills/; this is the step that
#                         reports the gap. A WARN for the same reason as the other two: the
#                         library is mid-migration and most of it has never been passed, so
#                         blocking would just train everyone to use --no-verify.
#
# Warnings, not blocks, and deliberately so: CONTRIBUTING.md is explicit that a bump is not
# required for content to reach teammates, and a half-written page is a legitimate thing to
# push to a branch. Blocking either would train people to pass --no-verify, which would also
# disable the main-branch guard above. These run BEFORE the GW_PUSH escape hatch, because an
# authorised push to main is exactly when an unstamped change matters most.

set -uo pipefail
PROTECTED="main"
ROOT="$(git rev-parse --show-toplevel)"

# Never let a warning break a push: these are advisory, and a broken check script
# must not become the reason someone cannot ship.
if [ -x "$ROOT/scripts/check-version.sh" ]; then
  "$ROOT/scripts/check-version.sh" 2>&1 | sed 's/^/  /' || true
fi
if [ -x "$ROOT/scripts/check-placeholders.sh" ]; then
  OUT="$("$ROOT/scripts/check-placeholders.sh" 2>&1 || true)"
  case "$OUT" in *✘*) printf '%s\n' "$OUT" | grep -v '✔' | sed 's/^/  /' ;; esac
fi
if [ -x "$ROOT/scripts/check-skill-drift.sh" ]; then
  OUT="$("$ROOT/scripts/check-skill-drift.sh" 2>&1 || true)"
  # Only the wrong claims and the tally. The unverifiable list is long by nature — a node
  # id living only in Figma is normal — and printing it every push would bury the ✘ lines.
  printf '%s\n' "$OUT" | grep -E '✘|wrong ·' | sed 's/^/  /' || true
fi
if [ -x "$ROOT/scripts/library-site.sh" ]; then
  # /library is GENERATED but COMMITTED, and regenerating it is a hand-run step. That
  # combination is exactly how the rendered library drifts from foundation/ + exports/ —
  # the site then shows a human one thing while the skills read another, and nothing says
  # so. --check regenerates into a temp dir and diffs; a mismatch means someone changed a
  # source file (or the HTML itself) without rebuilding. WARN, not block, for the same
  # reason as everything else here: a half-finished branch is a legitimate thing to push.
  "$ROOT/scripts/library-site.sh" --check >/dev/null 2>&1 \
    || echo "  ~ preview/library is out of date — run: bash scripts/library-site.sh"
fi
if [ -x "$ROOT/scripts/review-pass.sh" ]; then
  OUT="$("$ROOT/scripts/review-pass.sh" --check 2>&1 || true)"
  # Only the summary line and the expired rows. The full pending list is long by design
  # while the library migrates, and a wall of output on every push is output nobody reads.
  printf '%s\n' "$OUT" | grep -E '^~|expired by a source change' | sed 's/^/  /' || true
fi

if [ "${GW_PUSH:-}" = "1" ]; then
  exit 0
fi

blocked=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  branch="${remote_ref#refs/heads/}"
  # a delete is an empty local sha; protection already blocks it server-side, flag it anyway
  case " $PROTECTED " in
    *" $branch "*) blocked="$blocked $branch" ;;
  esac
done

if [ -n "$blocked" ]; then
  cat >&2 <<EOF

✘ Push to$blocked blocked by scripts/hooks/pre-push

  Pushing this branch is meant to be a deliberate act, because an agent session in this
  clone pushes with your GitHub credentials and GitHub cannot distinguish it from you.

  If you meant to do this:

      GW_PUSH=1 git push origin$blocked

  Working on something else? Push a branch and open a PR instead:

      git switch -c my-change && git push -u origin my-change

EOF
  exit 1
fi

exit 0
